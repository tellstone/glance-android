# Keep source and documentation diffs stable across Windows and Unix checkouts.
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.bat text eol=crlf

# Do not attempt text normalization for generated/binary Android assets.
*.jar binary
*.png binary
*.webp binary
*.so binary
